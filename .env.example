# --- Database ---
# Postgres in production. For local dev you can use a local Postgres or a
# SQLite override (set provider in prisma/schema.prisma to "sqlite" and use
# `file:./dev.db` here).
DATABASE_URL="postgresql://ugs:ugs@localhost:5432/ugs?schema=public"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-32-random-bytes-base64"
NEXTAUTH_URL="http://localhost:3000"

# --- Google OAuth ---
# From https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Token encryption ---
# 32 random bytes, base64-encoded. Used as the key for AES-256-GCM encryption
# of OAuth refresh/access tokens at rest. Generate with:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""

# --- Limits ---
# Max upload size in bytes. Default 5 TB. Upload attempts larger than this are
# rejected at the route layer before any Drive API call.
MAX_UPLOAD_BYTES="5368709120"

# --- Cron ---
# Shared secret for /api/cron/sync. Vercel Cron sends it as a header.
CRON_SECRET=""
